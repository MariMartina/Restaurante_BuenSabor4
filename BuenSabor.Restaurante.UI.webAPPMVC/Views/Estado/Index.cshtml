@{
     ViewData["Title"] = "Índice deEstados";
}

<h1>@ViewData["Title"]</h1>
<form asp-action="Index" method="get" class="form-inline mb-3">
    <div class="input-group">
        <input type="text" name="BuscarNombre" value="@((string)ViewData["CurrentFilter"])" class="form-control" placeholder="Buscar por nombre..." />
        <div class="input-group-append">
            <button type="submit" class="btn btn-outline-secondary">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </div>
</form>
<p>
    <a asp-action="Create" class="btn btn-primary">Crear nuevo</a>
</p>
